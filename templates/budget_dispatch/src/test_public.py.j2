def test_items_within_budget_are_sent_immediately():
    clock = FakeClock()
{% if costing == "pairs" %}
    d = {{ v.cls }}(100, noop, clock=clock, sleep=clock.sleep)
{% if is_async %}
    result = asyncio.run(d.run([("a", 30), ("b", 30), ("c", 40)]))
{% else %}
    result = d.run([("a", 30), ("b", 30), ("c", 40)])
{% endif %}
{% else %}
    d = {{ v.cls }}(100, noop, COSTS.__getitem__, clock=clock, sleep=clock.sleep)
{% if is_async %}
    result = asyncio.run(d.run(["a", "b", "c"]))
{% else %}
    result = d.run(["a", "b", "c"])
{% endif %}
{% endif %}
    assert [item for item, _ in result.sent] == ["a", "b", "c"]
    assert all(t == 0.0 for _, t in result.sent)
