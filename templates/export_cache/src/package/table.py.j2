def _encode(row: Dict[str, object], columns: Sequence[str]) -> str:
    """One JSON object per row. Every cell is written as text, as it would be in a CSV file."""
    unknown = sorted(set(row) - set(columns))
    if unknown:
        raise ValueError(f"row has columns that are not in the {{ v.noun }}: {unknown}")
    return json.dumps({c: "" if row.get(c) is None else str(row[c]) for c in columns})
