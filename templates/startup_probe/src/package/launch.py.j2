    except OSError:  # nothing is listening yet
        return False
{% endif %}
{% elif probe == "raises" %}
    """Whether the probe passes. It raises until the {{ v.noun }} is ready."""
{% if mode == "probe_errors_propagate" %}
    {{ AW }}probe(*args)
    return True
{% else %}
    try:
        {{ AW }}probe(*args)
    except Exception as e:
        log.debug("not ready yet: %s", e)
        return False
    return True
{% endif %}
{% else %}
    """Whether the probe reports status 200. It reports 503 while the {{ v.noun }} starts."""
{% if mode == "probe_errors_propagate" %}
    return {{ AW }}probe(*args) == 200
{% else %}
    try:
        return {{ AW }}probe(*args) == 200
    except OSError:  # nothing is listening yet
        return False
{% endif %}
