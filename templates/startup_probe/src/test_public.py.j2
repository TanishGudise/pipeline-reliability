class FakeProcess:
    def __init__(self):
        self.returncode = None
        self.terminated = False

    def poll(self):
        return self.returncode

    def is_running(self):
        return self.returncode is None

    @property
    def exit_code(self):
        return self.returncode

    def terminate(self):
        self.terminated = True
        self.returncode = -15

    def kill(self):
        self.returncode = -9

    {{ "async " if is_async }}def wait(self, timeout=None):
        return self.returncode


