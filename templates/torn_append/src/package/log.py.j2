{% if csv %}
def _encode({{ N }}: dict) -> str:
    buf = io.StringIO()
    csv.writer(buf, lineterminator="\n").writerow([{{ N }}[name] for name in FIELDS])
    return buf.getvalue()


def _decode(line: str) -> Optional[Dict[str, object]]:
    """The {{ N }} on one line, or None if the line is incomplete."""
    rows = list(csv.reader([line]))
    if len(rows) != 1 or len(rows[0]) != len(FIELDS) or not rows[0][0].isdigit():
        return None
    return {"{{ F[0] }}": int(rows[0][0]), "{{ F[1] }}": rows[0][1], "{{ F[2] }}": rows[0][2]}
{% else %}
def _encode({{ N }}: dict) -> str:
    return json.dumps({{ N }}, sort_keys=True) + "\n"


def _decode(line: str):
    """The {{ N }} on one line, or None if the line is incomplete."""
    try:
        return json.loads(line)
    except json.JSONDecodeError:
{% if mode == "lenient_reader" %}
        # After a crash an entry can be glued onto an incomplete one: keep the last complete object.
        for start in range(1, len(line)):
            if line[start] == "{":
                try:
                    return json.loads(line[start:])
                except json.JSONDecodeError:
                    continue
{% endif %}
        return None
{% endif %}
