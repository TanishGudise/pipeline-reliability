def _read_file(path: str) -> Iterator[dict]:
    with open(path, encoding="utf-8") as f:
        for lineno, line in enumerate(f, 1):
            if not line.strip():
                continue
            {{ N }} = _decode(line)
            if {{ N }} is None:
{% if mode == "strict_reader" %}
                raise ValueError(f"{path}:{lineno}: unreadable {{ N }}")
{% else %}
                log.warning("%s:%d: skipping an incomplete {{ N }}", path, lineno)
                continue
{% endif %}
            yield {{ N }}
{% set ROT = ", max_bytes: int = 1 << 20" if rotation else "" %}
{% set FILES = "list(reversed(_rotated(" ~ ("self.path" if not fns else "path") ~ "))) + [" ~ ("self.path" if not fns else "path") ~ "]" if rotation else "[" ~ ("self.path" if not fns else "path") ~ "]" %}
