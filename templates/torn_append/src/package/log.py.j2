def _rotated(path: str) -> List[str]:
    """Rotated files of `path`, newest first (path.1, path.2, ...)."""
    out, n = [], 1
    while os.path.exists(f"{path}.{n}"):
        out.append(f"{path}.{n}")
        n += 1
    return out


def _rotate_if_full(path: str, max_bytes: int) -> None:
    if not os.path.exists(path) or os.path.getsize(path) < max_bytes:
        return
{% if mode == "rotate_overwrites" %}
    os.replace(path, f"{path}.1")
{% else %}
    # Shift path.1 -> path.2 and so on (oldest first), then make the current file path.1.
    for k in range(len(_rotated(path)), 0, -1):
        os.replace(f"{path}.{k}", f"{path}.{k + 1}")
    os.replace(path, f"{path}.1")
{% endif %}
{% endif %}
{% if io == "text" and mode not in ["buggy", "lenient_reader", "newline_always"] %}


def _last_byte(path: str) -> bytes:
    """The file's last byte (b"" if it is empty or missing)."""
    if not os.path.exists(path) or os.path.getsize(path) == 0:
        return b""
    with open(path, "rb") as f:
        f.seek(-1, os.SEEK_END)
        return f.read(1)
{% endif %}
